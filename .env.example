# Configuración de una instancia de lauyim (un gym). Copiar a .env y completar.
# Instalación: README.md. Las líneas comentadas (#) muestran el valor por defecto:
# solo hace falta descomentarlas para cambiarlo. Después de editar este archivo, recrear la API:
#   docker compose -p <proyecto> up -d api

# ---------------------------------------------------------------------------------------------
# Instancia (obligatorias)
# ---------------------------------------------------------------------------------------------

# Dominio de la instancia, sin https:// ni barra. Las passkeys quedan atadas a él: cambiarlo
# después deja a todos sin poder entrar.
RP_ID=gym.lauyim.online
# URL completa con la que se abre la app (https:// + RP_ID). Con https las cookies salen Secure.
ORIGIN=https://gym.lauyim.online
# Nombre que muestra el celular al crear la passkey ("lauyim" si queda vacío).
RP_NAME=lauyim
# Identificador de la instancia en los reportes de soporte (ej. gym-centro).
INSTANCE_NAME=

# Puerto del contenedor web en el servidor: cloudflared apunta a http://127.0.0.1:WEB_PORT. Uno
# distinto por instancia (8080, 8081, ...).
WEB_PORT=8080
# Interfaz donde se publica el puerto. 127.0.0.1: solo el servidor (cloudflared), así nadie entra
# sin pasar por Cloudflare. 0.0.0.0 lo abre a la red (por ejemplo, para probar desde la LAN). La IP
# real del visitante llega por CF-Connecting-IP, que nginx solo cree desde el propio servidor.
WEB_BIND=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Licencia
# ---------------------------------------------------------------------------------------------

# Abono mensual (como el contrato, cláusula Quinta). LICENSE_PAID_UNTIL es el último mes pagado
# (AAAA-MM, también 2026-9); renovar = pasarlo al mes siguiente y recrear la API. Sin espacios
# alrededor del =. Con 2026-10 pagado:
#   del 1 al 10 de noviembre: aviso amarillo al staff ("vence el 10/11");
#   del 11 al 25: en mora, aviso rojo al staff con la fecha de suspensión;
#   desde el 26: servicio suspendido para todos (el staff ve que es por falta de pago).
# Los socios no ven nada hasta la suspensión. Fechas en la zona horaria del gym (Admin → Cuotas).
# Vacía: sin control mensual.
LICENSE_PAID_UNTIL=
# Día del mes en que vence el abono (si el mes no lo tiene, el último).
# LICENSE_DUE_DAY=10
# Días de mora antes de suspender.
# LICENSE_SUSPEND_AFTER_DAYS=15

# Corte fijo por fecha (ISO 8601), para demos y pruebas: se avisa al staff 7 días antes y, vencida,
# el servicio se suspende. Vacía: sin corte fijo. Con hora y zona para que corte a fin del día en
# Argentina: 2026-12-31T23:59:59-03:00
LICENSE_EXPIRES_AT=

# ---------------------------------------------------------------------------------------------
# Acceso y registro
# ---------------------------------------------------------------------------------------------

# La primera cuenta que se registra en una instancia nueva queda como owner (dueño del gym).

# Modo invitado ("Continuar sin cuenta", todo en el navegador). En un gym conviene apagarlo.
ALLOW_GUEST=false
# true: solo se registra quien tiene un código de invitación o el QR del gym.
# INVITE_ONLY=false
# Solo para la instancia de demo de venta: cada cuenta que se registra queda admin.
# NEW_USERS_ADMIN=false
# Ids de usuario (separados por coma) que son admin aunque la base diga lo contrario. Para
# recuperar el acceso; lo normal es dar admin desde Usuarios.
# ADMIN_UIDS=
# Días que dura la sesión en un dispositivo antes de volver a pedir la passkey.
# SESSION_DAYS=90

# ---------------------------------------------------------------------------------------------
# Funciones
# ---------------------------------------------------------------------------------------------

# Encuesta inicial y generación automática de rutinas. false la oculta (las rutinas ya generadas
# quedan).
# SURVEY_ENABLED=true

# Módulo de nutrición: cálculo de metas y sugerencias de comida.
# 1: el admin ve el interruptor "cálculo automático" por socio (encendido por defecto) y un socio
#    sin sugerencias asignadas ve las plantillas globales.
# 0: sin interruptor, siempre manual: el socio ve solo lo que cargó el admin.
NUTRICION_AUTOMATICO=1

# Gifs e imágenes de los ejercicios del catálogo. 0 los oculta y muestra el mapa muscular en su
# lugar (los ejercicios creados por socios o por el staff ya lo usan). Para retirarlos del todo,
# ver docs/backup-restore.md → "Media de ejercicios".
EXERCISE_GIFS=1

# Versión mínima de la app (x.y.z de frontend/package.json). Una más vieja muestra "Hay una
# actualización necesaria". Ver docs/runbook-actualizaciones.md. Vacía: sin mínimo.
# MIN_CLIENT_VERSION=

# ---------------------------------------------------------------------------------------------
# Integraciones
# ---------------------------------------------------------------------------------------------

# Brevo: envía los reportes de "Problemas técnicos" a SUPPORT_DESTINATION_EMAIL. Sin clave, el
# reporte falla con un aviso.
BREVO_API_KEY=
SUPPORT_DESTINATION_EMAIL=soporte@lauyim.online

# USDA FoodData Central: búsqueda de alimentos en Nutrición.
USDA_API_KEY=

# Contacto que se informa a los servicios de notificaciones push (mailto: o https://). Por
# defecto, ORIGIN.
# VAPID_SUBJECT=
# Hosts extra (separados por coma) a los que se permite mandar notificaciones push, además de los
# de Google, Mozilla, Microsoft y Apple. Solo para un navegador con un servicio propio.
# PUSH_HOST_ALLOWLIST=

# ---------------------------------------------------------------------------------------------
# Encargado del tratamiento (aviso de privacidad)
# ---------------------------------------------------------------------------------------------

# Cómo figura lauyim en el aviso de privacidad. Vacías: solo "lauyim".
# OPERATOR_NAME=
# OPERATOR_CUIT=

# ---------------------------------------------------------------------------------------------
# Registro de auditoría (Admin → Logs)
# ---------------------------------------------------------------------------------------------

# false lo apaga (no recomendado: es la evidencia de quién hizo qué).
# AUDIT_LOG=true
# Días y cantidad máxima de eventos que se conservan.
# AUDIT_DAYS=90
# AUDIT_MAX=5000
# IP de cada evento: off (no se guarda), net (solo la red, x.x.x.0/24) o full (completa).
# AUDIT_IP=off

# ---------------------------------------------------------------------------------------------
# Límites de intentos (pedidos cada 5 minutos)
# ---------------------------------------------------------------------------------------------
# Los de IP son altos a propósito: los socios en el wifi del gym comparten una IP pública.

# RATE_LIMIT_LOGIN_MAX=60            # por IP: inicio de sesión
# RATE_LIMIT_REGISTER_MAX=30         # por IP: registro
# RATE_LIMIT_QR_MAX=60               # por IP: QR de acceso
# RATE_LIMIT_DEVICE_START_MAX=30     # por IP: empezar a vincular un dispositivo
# RATE_LIMIT_DEVICE_MAX=60           # por IP: aprobar un dispositivo
# RATE_LIMIT_PER_CREDENTIAL_MAX=10   # por passkey: inicio de sesión
# RATE_LIMIT_PER_USER_MAX=10         # por usuario: aprobar un dispositivo
# RATE_LIMIT_SHARE_MAX=20            # por IP: planes compartidos
# RATE_LIMIT_SUPPORT_MAX=5           # por IP: reportes de soporte
# RATE_LIMIT_LINK_MAX=30             # por IP: código de vinculación del gym
# RATE_LIMIT_PER_LINK_CODE_MAX=20    # por código de vinculación
# RATE_LIMIT_IMPORT_MAX=30           # por usuario: importar socios (incluye vistas previas)
# RATE_LIMIT_CHECKIN_DEVICE_MAX=60   # por dispositivo: búsquedas en Ingreso Físico
# RATE_LIMIT_CHECKIN_IP_MAX=300      # por IP: Ingreso Físico

# ---------------------------------------------------------------------------------------------
# Avanzadas (normalmente no se tocan)
# ---------------------------------------------------------------------------------------------

# Puerto interno de la API; el web lo sigue solo.
# PORT=3000
# Puerto interno de nginx y nombre del servicio de la API dentro del compose.
# NGINX_PORT=80
# BACKEND=api
# Diagnóstico de los recordatorios push en el log (y solo de un usuario, con DEBUG_USER_ID).
# SCHEDULER_DEBUG=false
# DEBUG_USER_ID=

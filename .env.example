# Brevo API Key for sending support emails and automated reports
BREVO_API_KEY=

# USDA FoodData Central API key for translated food searches
USDA_API_KEY=

# Support destination email (defaults to soporte@lauyim.online)
SUPPORT_DESTINATION_EMAIL=soporte@lauyim.online

# Instance name / identifier for support reports (e.g. lauyim, gimnasio-central)
INSTANCE_NAME=

# Nutrition module: controls both goal calculation and food suggestion fallback.
# NUTRICION_AUTOMATICO=1 (default): admin sees an "automatic calculation" toggle per
#   member, on by default; a member without admin-assigned suggestions still sees the
#   global templates.
# NUTRICION_AUTOMATICO=0: the toggle is hidden — mode is always manual. A member sees
#   only what the admin loaded (goals, suggestions); nothing is calculated or shown
#   from globals until the admin sets it.
NUTRICION_AUTOMATICO=1

# Web container port on the host. cloudflared (running on the host) points at
# http://127.0.0.1:WEB_PORT.
WEB_PORT=8080
# Interface the web port is published on. Default 127.0.0.1: only the host (cloudflared)
# can reach it, so nobody bypasses Cloudflare. 0.0.0.0 opens it to the network (e.g. to
# test from another machine on the LAN). The visitor's real IP comes from Cloudflare's
# CF-Connecting-IP, which nginx only trusts from loopback / the docker gateway; nothing
# to configure for it.
WEB_BIND=127.0.0.1

# Rate limit (requests per 5 minutes; every request counts). Per-IP limits are high on
# purpose: members on the gym's wifi share one public IP. Defaults shown.
# RATE_LIMIT_LOGIN_MAX=60            # per IP: login options + verify
# RATE_LIMIT_REGISTER_MAX=30         # per IP: register options + verify
# RATE_LIMIT_QR_MAX=60               # per IP: QR access check
# RATE_LIMIT_DEVICE_START_MAX=30     # per IP: start a device pairing
# RATE_LIMIT_DEVICE_MAX=60           # per IP: device claim + confirm
# RATE_LIMIT_PER_CREDENTIAL_MAX=10   # per passkey: login verify
# RATE_LIMIT_PER_USER_MAX=10         # per signed-in user: device claim + confirm
# RATE_LIMIT_SHARE_MAX=20            # per IP: shared plans
# RATE_LIMIT_SUPPORT_MAX=5           # per IP: support reports

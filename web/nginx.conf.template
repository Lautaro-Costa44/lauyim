# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Sent on every response below. NOTE: an `add_header` inside a location replaces the whole
    # inherited set rather than adding to it, so the two locations further down that set their
    # own Cache-Control have to repeat these three. Deliberately not a full Content-Security-
    # Policy: only frame-ancestors, which no part of the app depends on. TLS, HSTS and any
    # stricter policy stay the reverse proxy's job (see SECURITY.md).
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # IP real del visitante. cloudflared corre en el host y entra por el puerto publicado, así
    # que nginx ve la conexión desde el gateway de la red docker (172.16.0.0/12) o desde
    # loopback. Solo desde ahí se cree CF-Connecting-IP (lo pone Cloudflare y pisa el del
    # cliente) y $remote_addr pasa a ser el visitante. Desde cualquier otra IP el header se
    # ignora y $remote_addr queda como la conexión real, así que nadie de afuera puede elegir
    # su dirección. Sin el header (acceso local sin Cloudflare) también queda la conexión.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 172.16.0.0/12;
    real_ip_header CF-Connecting-IP;

    # API → backend container.
    # `^~` so this prefix beats the regex locations below: without it a request for a path such
    # as /api/anything.json would be matched by the \.(js|css|json|html)$ block instead and be
    # looked for on disk rather than proxied.
    location ^~ /api/ {
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr, NOT $proxy_add_x_forwarded_for: the latter APPENDS to whatever the client
        # sent, and the API reads the first entry — so a client could put any address it liked in
        # front of its own and choose what the activity log recorded about it. Overwriting is what
        # makes the header mean anything.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # $remote_addr ya es el visitante (realip, arriba). La API no lee CF-Connecting-IP: el
        # valor vacío hace que nginx no lo reenvíe.
        proxy_set_header CF-Connecting-IP "";
    }

    # SPA fallback
    location ^~ /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
